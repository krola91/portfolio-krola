<div class="scorpion-crawler" data-scorpion-crawler aria-hidden="true">
	<div class="scorpion-crawler__body">
		<img
			alt=""
			class="scorpion-crawler__image"
			decoding="async"
			draggable="false"
			height="1037"
			src="/sources/escorp.png"
			width="1024"
		/>
	</div>
</div>

<style>
	.scorpion-crawler {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 45;
		width: clamp(32px, 9vw, 114px);
		aspect-ratio: 1024 / 1037;
		opacity: 0;
		pointer-events: none;
		transform: translate3d(75vw, 70vh, 0) translate(-50%, -50%);
		transform-origin: center;
		transition: opacity 400ms ease;
		will-change: transform;
	}

	.scorpion-crawler.is-ready {
		opacity: 0.88;
	}

	.scorpion-crawler__body {
		width: 100%;
		height: 100%;
	}

	.scorpion-crawler__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		filter:
			drop-shadow(0 10px 9px rgb(0 0 0 / 55%))
			drop-shadow(0 0 7px rgb(25 64 247 / 24%));
		user-select: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.scorpion-crawler {
			right: 1rem;
			bottom: 1rem;
			top: auto;
			left: auto;
			width: clamp(32px, 9vw, 114px);
			opacity: 0.65;
			transform: none;
		}
	}
</style>

<script>
	const crawler = document.querySelector<HTMLElement>("[data-scorpion-crawler]");

	if (crawler && crawler.dataset.crawlerReady !== "true") {
		crawler.dataset.crawlerReady = "true";

		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

		if (reducedMotion.matches) {
			crawler.classList.add("is-ready");
		} else {
			let x = window.innerWidth * 0.78;
			let y = window.innerHeight * 0.72;
			let pointerX = x;
			let pointerY = y;
			let hasPointer = false;
			let lastFrame = performance.now();
			let angle = 0;

			const clamp = (value: number, minimum: number, maximum: number) =>
				Math.min(Math.max(value, minimum), maximum);

			const handlePointerMove = (event: PointerEvent) => {
				if (event.pointerType === "touch") return;
				pointerX = event.clientX;
				pointerY = event.clientY;
				hasPointer = true;
			};

			window.addEventListener("pointermove", handlePointerMove, { passive: true });

			const animateCrawler = (now: number) => {
				const delta = Math.min(40, now - lastFrame);
				lastFrame = now;

				if (hasPointer) {
					const pointerDeltaX = pointerX - x;
					const pointerDeltaY = pointerY - y;
					const pointerDistance = Math.max(1, Math.hypot(pointerDeltaX, pointerDeltaY));
					const followDistance = clamp(window.innerWidth * 0.11, 120, 220);
					const radialX = pointerDeltaX / pointerDistance;
					const radialY = pointerDeltaY / pointerDistance;
					let goalX = pointerX - radialX * followDistance;
					let goalY = pointerY - radialY * followDistance;
					const edge = Math.min(crawler.offsetWidth * 0.4, window.innerWidth * 0.12);

					goalX = clamp(goalX, edge, window.innerWidth - edge);
					goalY = clamp(goalY, edge, window.innerHeight - edge);

					const previousX = x;
					const previousY = y;
					const easing = 1 - Math.pow(0.99, delta / 16.667);
					x += (goalX - x) * easing;
					y += (goalY - y) * easing;

					const movementX = x - previousX;
					const movementY = y - previousY;
					if (Math.hypot(movementX, movementY) > 0.03) {
						const desiredAngle = Math.atan2(movementY, movementX) * (180 / Math.PI);
						const angleDifference = ((desiredAngle - angle + 540) % 360) - 180;
						angle += angleDifference * 0.04;
					}

					crawler.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%) rotate(${angle}deg)`;
				}

				crawler.classList.add("is-ready");
				window.requestAnimationFrame(animateCrawler);
			};

			window.requestAnimationFrame(animateCrawler);
		}
	}
</script>
