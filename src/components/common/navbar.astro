<style>
	.scramble {
		font-family: monospace;
		letter-spacing: 0.02em;
	}

	@keyframes availability-blink {
		0%,
		100% {
			opacity: 1;
		}

		50% {
			opacity: 0.18;
		}
	}

	.availability-indicator {
		animation: availability-blink 1s ease-in-out infinite;
	}

	@media (prefers-reduced-motion: reduce) {
		.availability-indicator {
			animation: none;
		}
	}
</style>

<script>
	const scrambleGlyphs = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789<>/[]{}#%&*";
	const reduceScrambleMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	document.querySelectorAll<HTMLElement>("[data-scramble]").forEach((element) => {
		if (element.dataset.scrambleReady === "true") return;

		const text = element.dataset.text ?? element.textContent?.trim() ?? "";
		element.dataset.scrambleReady = "true";

		if (reduceScrambleMotion) {
			element.textContent = text;
			return;
		}

		const runScramble = () => {
			let frame = 0;
			const framesPerCharacter = 3;

			const interval = window.setInterval(() => {
				const lockedCharacters = Math.floor(frame / framesPerCharacter);

				element.textContent = [...text]
					.map((character, index) => {
						if (character === " ") return " ";
						if (index < lockedCharacters) return character;
						return scrambleGlyphs[Math.floor(Math.random() * scrambleGlyphs.length)];
					})
					.join("");

				frame += 1;

				if (lockedCharacters >= text.length) {
					window.clearInterval(interval);
					element.textContent = text;
					window.setTimeout(runScramble, 3600);
				}
			}, 42);
		};

		runScramble();
	});
</script>
