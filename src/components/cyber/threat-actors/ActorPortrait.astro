---
import type { ThreatActor } from "../../../types/threat-actors";
import { canShowPortrait } from "../../../lib/cyber/threat-actors/actor-statistics";
interface Props { actor: ThreatActor; context: "card" | "dossier" | "ledger"; }
const { actor, context } = Astro.props;
const showPortrait = canShowPortrait(actor.portrait);
const seed = [...actor.id].reduce((value, char) => (value * 31 + char.charCodeAt(0)) >>> 0, 7);
const dots = Array.from({ length: 360 }, (_, i) => {
	const x = 90 + (i % 24) * 8; const y = 8 + Math.floor(i / 24) * 10;
	const radius = Math.hypot(x - 180, (y - 78) * 1.15);
	return { x, y, opacity: ((seed + i * 73) % 11) / 15, show: radius > 27 + seed % 10 && radius < 77 };
}).filter((dot) => dot.show);
---
<div class:list={["actor-portrait", { "is-fallback": !showPortrait }]}>
	{showPortrait ? <img src={actor.portrait.localPath!} alt={actor.portrait.alt} width="720" height="480" loading="lazy" decoding="async" /> :
		<svg viewBox="0 0 360 160" role="img" aria-label={actor.portrait.alt} width="360" height="160">
			<g fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.25"><path d="M0 40H360M0 80H360M0 120H360M60 0V160M120 0V160M180 0V160M240 0V160M300 0V160" />
				{Array.from({ length: 7 }, (_, i) => <ellipse cx="180" cy="78" rx={36 + i * 7 + seed % 5} ry={23 + i * 7} transform={`rotate(${seed % 80 - 40} 180 78)`} />)}
			</g>
			<g fill="currentColor">{dots.map((dot) => <rect x={dot.x} y={dot.y} width="2" height="2" opacity={dot.opacity} />)}</g>
			<path d="M157 58h12m-12 0v12m46-12h-12m12 0v12m-46 30h12m-12 0V88m46 12h-12m12 0V88" stroke="currentColor" fill="none" opacity="0.65" />
			<text x="180" y="89" text-anchor="middle" fill="currentColor" font-family="monospace" font-size="29">{String(actor.index).padStart(2, "0")}</text>
		</svg>
	}
	<div class="actor-portrait__register" aria-hidden="true"><span>ARCHIVE / {String(actor.index).padStart(2, "0")}</span><span>{showPortrait ? "DITHER PORTRAIT" : context === "dossier" ? "RECORD MARKER" : "ID / DOCUMENTED"}</span></div>
	{!showPortrait && <p>{context === "ledger" ? "NO VERIFIED PORTRAIT" : "OFFICIAL IMAGE NOT AVAILABLE"} <span>{context === "ledger" ? "Abstract ID · not a likeness" : "Abstract marker · not a likeness"}</span></p>}
	<i class="actor-portrait__scan" aria-hidden="true"></i>
</div>
