<div class="explainer-backdrop" data-explainer-backdrop hidden></div>
<div
	id="vulnerability-explainer-trigger-hint"
	class="explainer-trigger-hint"
	data-explainer-trigger-hint
	role="tooltip"
	hidden
>MORE INFO — CLICK TO OPEN</div>
<aside
	id="vulnerability-explainer-popover"
	class="explainer-popover"
	data-explainer-popover
	role="dialog"
	aria-modal="true"
	aria-hidden="true"
	aria-labelledby="explainer-title"
	tabindex="-1"
	hidden
>
	<div class="explainer-popover__dither" aria-hidden="true"></div>
	<header>
		<p data-explainer-index>CONCEPT // —</p>
		<button type="button" data-explainer-close aria-label="Close explanation">×</button>
	</header>
	<h2 id="explainer-title" data-explainer-title>—</h2>
	<div class="explainer-popover__body">
		<section><h3>What it means</h3><p data-explainer-definition>—</p></section>
		<section><h3>Why it is here</h3><p data-explainer-purpose>—</p></section>
		<section><h3>How to read it</h3><p data-explainer-reading>—</p></section>
		<section><h3>Limit</h3><p data-explainer-limit>—</p></section>
	</div>
	<footer>
		<p data-explainer-attribution>—</p>
		<nav aria-label="Primary sources" data-explainer-sources hidden></nav>
	</footer>
	<i class="explainer-popover__connector" aria-hidden="true"></i>
</aside>
