---
import type { DatasetIntegrity, KevDatasetMetadata } from "../../types/cyber";
import { ACTORS } from "../../data/cyber/threat-actors/actors";
import { actorStatistics } from "../../lib/cyber/threat-actors/actor-statistics";

interface Props { metadata: KevDatasetMetadata; health: DatasetIntegrity; }
const { metadata, health } = Astro.props;
const actors = actorStatistics(ACTORS);
const released = new Intl.DateTimeFormat("en", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }).format(new Date(metadata.dateReleased));
---

<header class="obs-header">
	<a class="obs-header__identity" href="/cyber-observatory" aria-label="Cyber Intelligence Observatory home">
		<span class="obs-header__mark" aria-hidden="true"><i></i><i></i></span>
		<span><strong>Cyber Intelligence Observatory</strong><small data-header-subtitle>LAB/EXP-002 · Curated actor evidence interface</small></span>
	</a>
	<div class="obs-header__telemetry" aria-label="Dataset status">
		<span class="status-pulse is-verified" data-source-module="actors"><i aria-hidden="true"></i>curated</span>
		<span class:list={["status-pulse", `is-${health}`]} data-source-module="vulnerabilities" hidden><i aria-hidden="true"></i>{health}</span>
		<span class="utc-clock" data-utc-clock>UTC --:--:--</span>
		<a class="source-flag" data-source-module="actors" href="#actors-sources">ActorDex · {actors.total} curated profiles · reviewed {actors.lastVerified} UTC</a>
		<a class="source-flag" data-source-module="vulnerabilities" hidden href={metadata.sourceUrl} target="_blank" rel="noopener noreferrer">CISA KEV · official snapshot · {metadata.catalogVersion} · {metadata.validCount} records · {released}</a>
	</div>
	<div class="obs-header__actions">
		<button class="command-trigger" type="button" data-command-open aria-haspopup="dialog"><span>Command</span><kbd>⌘ K</kbd></button>
		<a class="back-link" href="/#the-lab">Back to portfolio <span aria-hidden="true">↗</span></a>
	</div>
</header>
