---
const capabilities = [
	{ index: "01", label: "Visual tamper analysis" },
	{ index: "02", label: "Structural validation" },
	{ index: "03", label: "Reliability scoring" },
];
---

<section id="the-lab" class="lab-section" aria-labelledby="lab-title">
	<div class="lab-container">
		<header class="lab-section-header">
			<h2 id="lab-title" class="lab-section-title">
				<span>/03</span>
				THE-LAB
			</h2>

			<p class="lab-section-status">
				<span aria-hidden="true"></span>
				Experimental security systems
			</p>
		</header>

		<article class="lab-project" aria-labelledby="lab-project-title">
			<div class="lab-copy">
				<div class="lab-meta" aria-label="Project metadata">
					<span>EXP_01</span>
					<span>AI / FORENSICS</span>
				</div>

				<p class="lab-eyebrow">Prototype in development</p>

				<h3 id="lab-project-title">
					AI-Powered
					<span>Bank Transfer</span>
					Forensics
				</h3>

				<p class="lab-description">
					An intelligent forensic mini-app that inspects bank transfer receipts for visual and structural manipulation. It detects altered dates, modified amounts, and pixel-level tampering—delivering an instant reliability score to verify payment authenticity.
				</p>

				<dl class="lab-capabilities">
					{capabilities.map((capability) => (
						<div>
							<dt>{capability.index}</dt>
							<dd>{capability.label}</dd>
						</div>
					))}
				</dl>

				<div class="lab-action-row">
					<a class="terminal-button" href="/cyber-observatory#vulnerabilities">
						<span class="terminal-button__face"><span aria-hidden="true">&gt;_</span> Try now</span>
					</a>

					<span class="lab-build-id">BUILD_00.1</span>
				</div>
			</div>

			<figure class="lab-visual">
				<figcaption class="lab-visual-header">
					<span>TRANSFER_FORENSICS / DASHBOARD</span>
					<span class="lab-live-status">System preview</span>
				</figcaption>

				<div class="lab-dashboard-frame">
					<div class="lab-dashboard-screen">
						<img
							alt="Dashboard de análisis forense de transferencias bancarias"
							class="lab-image lab-image-main"
							decoding="async"
							height="768"
							loading="lazy"
							src="/sources/example-dashboard.jpg"
							width="1376"
						/>
						<img
							alt=""
							aria-hidden="true"
							class="lab-image lab-image-glitch"
							height="768"
							src="/sources/example-dashboard.jpg"
							width="1376"
						/>
					</div>
				</div>

				<div class="lab-telemetry" aria-label="Analysis capabilities">
					<span>PIXEL_LAYER / ACTIVE</span>
					<span>STRUCTURE / READY</span>
					<span>SCORE_ENGINE / 00—100</span>
				</div>
			</figure>
		</article>
	</div>
</section>

<style>
	.lab-section {
		--lab-bg: var(--color-section-surface);
		--lab-surface: #0c0f0d;
		--lab-elevated: #141815;
		--lab-text: var(--color-grey);
		--lab-muted: rgb(226 226 228 / 62%);
		--lab-faint: rgb(226 226 228 / 10%);
		--lab-border: rgb(226 226 228 / 22%);
		--lab-border-strong: rgb(226 226 228 / 42%);
		--lab-accent: var(--color-electric-lime);
		--lab-blue: var(--color-super-light-blue);

		padding: clamp(2.5rem, 4vw, 4rem) clamp(1.25rem, 3vw, 3rem);
		background: var(--lab-bg);
		border-block: 1px solid var(--lab-border);
	}

	.lab-container {
		width: 100%;
		max-width: 1600px;
		margin-inline: auto;
	}

	.lab-section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: clamp(1.5rem, 2.5vw, 2.5rem);
	}

	.lab-section-title {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin: 0;
		color: var(--lab-text);
		font-family: var(--font-title);
		font-size: clamp(1.25rem, 2vw, 1.75rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0.08em;
	}

	.lab-section-title span {
		color: var(--color-signal-blue);
	}

	.lab-section-status,
	.lab-meta,
	.lab-eyebrow,
	.lab-build-id,
	.lab-visual-header,
	.lab-telemetry {
		font-family: var(--font-accent);
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.lab-section-status {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0;
		color: var(--lab-muted);
	}

	.lab-section-status span {
		width: 0.45rem;
		height: 0.45rem;
		background: var(--lab-accent);
		box-shadow: 0 0 12px rgb(193 250 11 / 38%);
	}

	.lab-project {
		position: relative;
		display: grid;
		min-width: 0;
		overflow: clip;
		background-color: var(--lab-surface);
		background-image:
			linear-gradient(var(--lab-faint) 1px, transparent 1px),
			linear-gradient(90deg, var(--lab-faint) 1px, transparent 1px);
		background-size: 40px 40px;
		border: 1px solid var(--lab-border);
		box-shadow: 0 18px 48px rgb(0 0 0 / 24%);
	}

	.lab-project::before,
	.lab-project::after {
		position: absolute;
		z-index: 10;
		width: 20px;
		height: 20px;
		content: "";
		pointer-events: none;
	}

	.lab-project::before {
		top: -1px;
		left: -1px;
		border-top: 2px solid var(--lab-accent);
		border-left: 2px solid var(--lab-accent);
	}

	.lab-project::after {
		right: -1px;
		bottom: -1px;
		border-right: 2px solid var(--lab-accent);
		border-bottom: 2px solid var(--lab-accent);
	}

	.lab-copy {
		position: relative;
		z-index: 2;
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: center;
		padding: clamp(1.5rem, 3vw, 3.25rem);
		background: rgb(12 15 13 / 92%);
		border-bottom: 1px solid var(--lab-border);
	}

	.lab-meta {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.85rem;
		color: var(--lab-muted);
		border-bottom: 1px solid var(--lab-border);
	}

	.lab-meta span:first-child,
	.lab-eyebrow {
		color: var(--lab-accent);
	}

	.lab-eyebrow {
		margin: clamp(1.5rem, 2.5vw, 2.5rem) 0 0;
	}

	.lab-copy h3 {
		max-width: 11ch;
		margin: 0.75rem 0 0;
		color: var(--lab-text);
		font-family: var(--font-title);
		font-size: clamp(2rem, 3.4vw, 4.25rem);
		font-weight: 800;
		line-height: 0.96;
		letter-spacing: -0.045em;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.lab-copy h3 span {
		display: block;
		color: var(--lab-accent);
	}

	.lab-description {
		max-width: 34rem;
		margin: clamp(1.25rem, 2vw, 2rem) 0 0;
		color: var(--lab-muted);
		font-family: var(--font-body);
		font-size: clamp(1rem, 1.05vw, 1.0625rem);
		font-weight: 400;
		line-height: 1.65;
	}

	.lab-capabilities {
		display: grid;
		margin: clamp(1.5rem, 2.5vw, 2.5rem) 0 0;
		border-top: 1px solid var(--lab-border);
	}

	.lab-capabilities div {
		display: grid;
		grid-template-columns: 2.25rem minmax(0, 1fr);
		align-items: center;
		min-height: 2.25rem;
		border-bottom: 1px solid var(--lab-border);
	}

	.lab-capabilities dt,
	.lab-capabilities dd {
		margin: 0;
		font-family: var(--font-accent);
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.lab-capabilities dt {
		color: var(--lab-accent);
	}

	.lab-capabilities dd,
	.lab-build-id {
		color: var(--lab-muted);
	}

	.lab-action-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: clamp(1.5rem, 2.5vw, 2.5rem);
	}





	.lab-visual {
		position: relative;
		z-index: 1;
		display: flex;
		min-width: 0;
		min-height: 25rem;
		flex-direction: column;
		margin: 0;
		padding: clamp(1rem, 2vw, 1.75rem);
		background: radial-gradient(circle at 50% 50%, rgb(25 64 247 / 15%), transparent 48%), var(--lab-elevated);
	}

	.lab-visual-header,
	.lab-telemetry {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		color: var(--lab-muted);
	}

	.lab-visual-header {
		padding-bottom: 0.85rem;
		border-bottom: 1px solid var(--lab-border);
	}

	.lab-live-status {
		position: relative;
		padding-left: 0.85rem;
		color: var(--lab-accent);
	}

	.lab-live-status::before {
		position: absolute;
		top: 50%;
		left: 0;
		width: 0.38rem;
		height: 0.38rem;
		background: var(--lab-accent);
		content: "";
		transform: translateY(-50%);
	}

	.lab-dashboard-frame {
		position: relative;
		display: grid;
		min-height: 0;
		flex: 1;
		place-items: center;
		padding: clamp(1.25rem, 2.5vw, 2.5rem);
	}

	.lab-dashboard-frame::before,
	.lab-dashboard-frame::after {
		position: absolute;
		width: 18px;
		height: 18px;
		content: "";
		pointer-events: none;
	}

	.lab-dashboard-frame::before {
		top: 1rem;
		left: 0;
		border-top: 1px solid var(--lab-blue);
		border-left: 1px solid var(--lab-blue);
	}

	.lab-dashboard-frame::after {
		right: 0;
		bottom: 1rem;
		border-right: 1px solid var(--lab-blue);
		border-bottom: 1px solid var(--lab-blue);
	}

	.lab-dashboard-screen {
		position: relative;
		width: 100%;
		max-width: 900px;
		aspect-ratio: 1376 / 768;
		overflow: hidden;
		background: #070908;
		border: 1px solid var(--lab-border-strong);
		box-shadow: 14px 16px 0 rgb(1 2 7 / 34%), 0 0 28px rgb(25 64 247 / 12%);
	}

	.lab-dashboard-screen::after {
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(to bottom, transparent 0 3px, rgb(1 2 7 / 12%) 3px 4px);
		content: "";
		pointer-events: none;
	}

	.lab-image {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
	}

	.lab-image-main {
		transition: filter 220ms ease, transform 220ms ease;
	}

	.lab-image-glitch {
		opacity: 0;
		filter: contrast(1.35) brightness(1.25) hue-rotate(52deg);
		mix-blend-mode: screen;
		pointer-events: none;
	}

	.lab-visual:hover .lab-image-main {
		filter: contrast(1.08) saturate(1.12);
		transform: scale(1.012);
	}

	.lab-visual:hover .lab-image-glitch {
		animation: lab-glitch 680ms steps(1, end) 1;
	}

	.lab-telemetry {
		padding-top: 0.85rem;
		border-top: 1px solid var(--lab-border);
	}

	@keyframes lab-glitch {
		0%, 100% {
			clip-path: inset(0);
			opacity: 0;
			transform: translateX(0);
		}
		14% {
			clip-path: inset(12% 0 66% 0);
			opacity: 0.62;
			transform: translateX(9px);
		}
		29% {
			clip-path: inset(58% 0 20% 0);
			opacity: 0.4;
			transform: translateX(-7px);
		}
		43% {
			clip-path: inset(31% 0 48% 0);
			opacity: 0.72;
			transform: translateX(5px);
		}
		58% {
			clip-path: inset(76% 0 8% 0);
			opacity: 0.34;
			transform: translateX(-4px);
		}
	}

	@media (min-width: 1024px) {
		.lab-project {
			grid-template-columns: minmax(0, 35fr) minmax(0, 65fr);
			min-height: clamp(30rem, 34vw, 34rem);
		}

		.lab-copy {
			border-right: 1px solid var(--lab-border);
			border-bottom: 0;
		}
	}

	@media (max-width: 767px) {
		.lab-section-header,
		.lab-telemetry {
			align-items: flex-start;
			flex-direction: column;
		}

		.lab-section-status {
			display: none;
		}

		.lab-copy h3 {
			max-width: 12ch;
		}

		.lab-build-id {
			display: none;
		}

		.lab-visual {
			min-height: 22rem;
		}

		.lab-dashboard-frame {
			padding-inline: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.lab-image-main {
			transition: none;
		}

		.lab-visual:hover .lab-image-glitch {
			animation: none;
		}
	}
</style>
